OPENAI_API_KEY=
# Leave empty to run in fallback mode (Open in Outlook + manual Mark sent/replied).
MS_CLIENT_ID=
MS_TENANT=organizations
# OPENAI_MODEL=gpt-6-luna

# --- v2 (Next.js on Vercel). Set these in Vercel project env vars; `vercel env pull .env.local` for local dev.
DATABASE_URL=
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
ALLOWED_EMAIL=
# OUTLOOK_SCOPES=Mail.ReadWrite User.Read   (if the tenant refuses Mail.Send)
