[Unit]
Description=netWorth
After=network.target

[Service]
User=seankim
WorkingDirectory=/home/seankim/netWorth
# ponytail: one worker because last_search and Outlook login_state live in process memory; threads cover concurrency.
ExecStart=/home/seankim/netWorth/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5050 app:app
Restart=always

[Install]
WantedBy=multi-user.target
